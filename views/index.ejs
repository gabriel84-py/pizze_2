<%- include('partials/head', { pageTitle: '' }) %>
<%- include('partials/nav') %>

<main>

  <!-- ══════════ HERO ══════════ -->
  <section class="hero" id="hero">
    <div class="hero-media">
      <img
        src="/uploads/<%= s.hero_photo || 'devanture-nuit.jpg' %>"
        alt="Parigina pizzeria — <%= s.address_city %>"
        fetchpriority="high"
        width="1920" height="1080"
      >
    </div>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="hero-body">
      <div class="container">

        <div class="open-status on-dark <%= status.open ? 'is-open' : 'is-closed' %>" style="width:fit-content">
          <span class="status-dot"></span>
          <% if (status.open) { %>
            <%= t('hero.open_now') %>
          <% } else if (status.opensAt) { %>
            <%= t('hero.closed_opens', { time: status.opensAt }) %>
          <% } else if (status.nextOpen) { %>
            <%= t('hero.closed_opens', { time: status.nextOpen.day + ' ' + status.nextOpen.time }) %>
          <% } else { %>
            <%= t('hero.closed_today') %>
          <% } %>
        </div>

        <div class="hero-eyebrow">Villeneuve-lès-Avignon</div>

        <h1 class="hero-title">
          <% const lines = (s.hero_title || 'Pizza napolitaine\nau feu de bois').split('\n'); %>
          <% lines.forEach((line, i) => { %>
            <% if (i === 0) { %><strong><%= line %></strong><% } else { %><em><%= line %></em><% } %>
          <% }) %>
        </h1>

        <p class="hero-sub"><%= s.hero_tagline || 'Recettes traditionnelles de Naples — pâte fraîche, four à bois, produits d\'exception.' %></p>

        <div class="hero-actions">
          <a href="tel:<%= s.phone %>" class="btn btn-gold btn-lg">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
            <%= t('hero.cta_call') %>
          </a>
          <a href="/carte?lang=<%= lang %>" class="btn btn-outline-light btn-lg"><%= t('hero.cta_menu') %></a>
        </div>

        <div class="hero-rating">
          <div class="hero-stars" aria-label="Note <%= s.google_rating %> étoiles sur 5">
            <% for(let i=0;i<5;i++) { %><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><% } %>
          </div>
          <strong><%= s.google_rating %></strong>
          <span><%= s.google_count %> avis Google</span>
        </div>

      </div>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ══════════ MARQUE ══════════ -->
  <section class="brand-section">
    <div class="brand-inner container">

      <div class="brand-text reveal-left">
        <span class="section-label on-dark">Notre histoire</span>
        <h2 class="section-title on-dark">L'âme de Naples<br><em>à Villeneuve</em></h2>
        <p>Parigina est née d'une passion absolue pour la vraie pizza napolitaine — celle que l'on trouve dans les ruelles de Naples, cuite en 90 secondes dans un four à bois brûlant à 400°C.</p>
        <p>D'abord food truck dans le Vaucluse, puis pizzeria fixe depuis 2024 : chaque étape a été guidée par la même exigence, les mêmes recettes, le même feu.</p>
        <div class="brand-pillars">
          <div class="brand-pillar">
            <div class="brand-pillar-icon">🔥</div>
            <h4>Four à bois</h4>
            <p>Cuisson à plus de 400°C — une pâte légère et légèrement fumée.</p>
          </div>
          <div class="brand-pillar">
            <div class="brand-pillar-icon">🌿</div>
            <h4>Pâte fraîche</h4>
            <p>Pétrie et étirée à la main chaque jour selon la tradition.</p>
          </div>
          <div class="brand-pillar">
            <div class="brand-pillar-icon">🇮🇹</div>
            <h4>Ingrédients italiens</h4>
            <p>Bufala, Parme 24 mois, Parmigiano Reggiano, tomates du Sud.</p>
          </div>
          <div class="brand-pillar">
            <div class="brand-pillar-icon">⭐</div>
            <h4>4.9/5 Google</h4>
            <p>La confiance de nos clients, notre meilleure récompense.</p>
          </div>
        </div>
      </div>

      <div class="brand-visual reveal-right">
        <div class="brand-img-wrap">
          <% const brandPhoto = s.about_photo_1 || 'four-bois.webp'; %>
          <img src="/uploads/<%= brandPhoto %>" alt="Four à bois Parigina" loading="lazy" width="600" height="750">
          <div class="brand-img-overlay"></div>
          <div class="brand-img-caption">
            <h3>Le four, cœur de Parigina</h3>
            <p>Brique réfractaire · Feu de bois · 400°C</p>
          </div>
        </div>
        <div class="brand-stat-badge">
          <span class="brand-stat-num"><%= s.google_count %></span>
          <span class="brand-stat-label">Avis<br>Google</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════ PIZZAS SIGNATURE ══════════ -->
  <% if (featured && featured.length > 0) { %>
  <section class="signature-section">
    <div class="container">
      <div class="signature-header">
        <div>
          <span class="section-label">Nos incontournables</span>
          <h2 class="section-title">Pizzas <em>signature</em></h2>
        </div>
        <a href="/carte?lang=<%= lang %>" class="btn btn-outline-dark">Voir toute la carte →</a>
      </div>

      <div class="pizza-grid">
        <% featured.slice(0, 4).forEach((pizza, i) => { %>
        <article class="pizza-card reveal" style="transition-delay:<%= i*80 %>ms">
          <div class="pizza-card-img">
            <% if (pizza.photo) { %>
              <img src="/uploads/<%= pizza.photo %>" alt="Pizza <%= pizza.name %>" loading="lazy" width="400" height="400">
            <% } else { %>
              <div class="pizza-card-no-photo">
                <svg viewBox="0 0 64 64" fill="none" width="48" aria-hidden="true">
                  <circle cx="32" cy="32" r="30" stroke="rgba(201,169,110,.15)" stroke-width="1.5"/>
                  <path d="M32 16c-8.8 0-16 7.2-16 16s7.2 16 16 16 16-7.2 16-16S40.8 16 32 16z" fill="rgba(201,169,110,.08)"/>
                </svg>
              </div>
            <% } %>
            <% if (pizza.is_featured) { %><span class="pizza-featured-tag">Signature</span><% } %>
          </div>
          <div class="pizza-card-body">
            <div class="pizza-card-top">
              <h3 class="pizza-name"><%= pizza.name %></h3>
              <span class="pizza-price"><%= pizza.price.toFixed(2).replace('.', ',') %> €</span>
            </div>
            <% if (pizza.description) { %>
            <p class="pizza-desc"><%= pizza.description %></p>
            <% } %>
            <div class="pizza-badges">
              <% if (pizza.badge_veggie) { %><span class="badge badge-veggie"><%= t('menu.veggie') %></span><% } %>
              <% if (pizza.badge_piquant) { %><span class="badge badge-piquant"><%= t('menu.spicy') %></span><% } %>
              <% if (pizza.badge_truffe) { %><span class="badge badge-truffe"><%= t('menu.truffle') %></span><% } %>
            </div>
          </div>
        </article>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ══════════ SAVOIR-FAIRE ══════════ -->
  <section class="craft-section">
    <div class="craft-grid">
      <div class="craft-media">
        <img src="/uploads/four-bois.webp" alt="Four à bois Parigina" loading="lazy" width="900" height="680">
        <div class="craft-media-overlay" aria-hidden="true"></div>
      </div>
      <div class="craft-content reveal-right">
        <span class="section-label on-dark">Notre savoir-faire</span>
        <h2 class="section-title on-dark">L'art napolitain<br>du <em>feu de bois</em></h2>
        <p>Chaque pizza Parigina commence par une pâte fraîche pétrie chaque jour, étirée à la main selon la pure tradition napolitaine. Le four à bois, cœur de notre cuisine, cuit vos pizzas à plus de 400°C en quelques minutes — le secret d'une pâte légère, alvéolée, avec un fumé incomparable.</p>
        <p>Nos ingrédients sont choisis avec soin : mozzarella di Bufala, jambon de Parme 24 mois, Parmigiano Reggiano, tomates cerises du Sud… L'Italie dans chaque bouchée.</p>
        <div class="craft-numbers">
          <div class="craft-num">
            <span>21</span>
            <p>Pizzas au menu</p>
          </div>
          <div class="craft-num">
            <span>400°</span>
            <p>Four à bois</p>
          </div>
          <div class="craft-num">
            <span>4.9</span>
            <p>Sur Google</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ AVIS ══════════ -->
  <% if (testis && testis.length > 0) { %>
  <section class="reviews-section">
    <div class="container text-center reveal">
      <span class="section-label"><%= t('reviews.title') %></span>
      <h2 class="section-title">Ce que disent<br><em>nos clients</em></h2>
      <div class="ornament">★</div>
    </div>

    <div class="reviews-marquee-wrap" aria-label="Avis clients" role="region">
      <div class="reviews-marquee" aria-hidden="true">
        <% const allChips = [...testis, ...testis]; %>
        <% allChips.forEach((testi) => { %>
        <div class="review-chip">
          <div class="review-stars-row">
            <% for(let i=0;i<(testi.rating||5);i++) { %><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><% } %>
          </div>
          <blockquote>"<%= testi.content %>"</blockquote>
          <div class="review-chip-footer">
            <div style="display:flex;align-items:center;gap:.65rem;">
              <div class="review-avatar"><%= testi.author.charAt(0).toUpperCase() %></div>
              <div class="review-author-info">
                <strong><%= testi.author %></strong>
                <% if (testi.date_str) { %><time><%= testi.date_str %></time><% } %>
              </div>
            </div>
            <div class="review-source-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
              Google
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <div class="container text-center mt-lg">
      <a href="/avis?lang=<%= lang %>" class="btn btn-outline-dark">Tous les avis →</a>
    </div>
  </section>
  <% } %>

  <!-- ══════════ INFOS PRATIQUES ══════════ -->
  <section class="infos-section">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label on-dark"><%= t('contact.title') %></span>
        <h2 class="section-title on-dark">Venez nous <em>rendre visite</em></h2>
        <span class="divider-gold" style="margin:1.25rem auto"></span>
      </div>

      <div class="infos-grid">

        <!-- Horaires -->
        <div class="infos-block reveal">
          <div class="infos-block-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3><%= t('hours.title') %></h3>
          <ul class="hours-list">
            <% horaires.forEach(h => { %>
            <li class="hours-row <%= h.is_closed ? 'closed' : '' %>">
              <span class="day"><%= h['day_name_' + lang] || h.day_name_fr %></span>
              <span class="time-dot"></span>
              <strong class="time"><%= h.is_closed ? t('hours.closed') : h.opens + ' – ' + h.closes %></strong>
            </li>
            <% }) %>
          </ul>
        </div>

        <!-- Contact -->
        <div class="infos-block reveal" style="transition-delay:100ms">
          <div class="infos-block-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3><%= t('contact.title') %></h3>
          <a href="tel:<%= s.phone %>" class="infos-phone"><%= s.phone_display %></a>
          <address class="infos-address">
            <%= s.address_street %><br><%= s.address_zip %> <%= s.address_city %>
          </address>
          <% if (s.email) { %>
          <a href="mailto:<%= s.email %>" style="font-size:.82rem;color:rgba(248,241,228,.5)"><%= s.email %></a>
          <% } %>
          <div class="infos-services">
            <span class="infos-service">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9h18M3 15h18M12 3v18"/></svg>
              Sur place
            </span>
            <span class="infos-service">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/></svg>
              À emporter
            </span>
            <span class="infos-service">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              Parking facile
            </span>
          </div>
        </div>

        <!-- Carte -->
        <div class="infos-block reveal" style="transition-delay:200ms">
          <div class="infos-block-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/></svg>
          </div>
          <h3>Nous trouver</h3>
          <div class="map-embed">
            <iframe
              src="https://maps.google.com/maps?q=43.9813667,4.7852979&z=16&output=embed"
              title="Carte Parigina Villeneuve-lès-Avignon"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <% if (s.google_maps_url) { %>
          <a href="<%= s.google_maps_url %>" target="_blank" rel="noopener" class="btn btn-outline-light btn-sm" style="margin-top:.5rem">
            Ouvrir dans Google Maps →
          </a>
          <% } %>
        </div>

      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js?v=2"></script>
</body>
</html>
