<%- include('partials/head', { pageTitle: t('nav.reviews') }) %>
<%- include('partials/nav') %>

<main>

  <!-- Page hero -->
  <section class="page-hero">
    <div class="container" style="position:relative;z-index:2">
      <span class="section-label on-dark"><%= s.google_count %> avis vérifiés</span>
      <h1><%= t('reviews.title') || 'Avis clients' %></h1>
    </div>
    <div class="page-hero-deco" aria-hidden="true">★</div>
  </section>

  <!-- Score + grille -->
  <section class="section">
    <div class="container">

      <!-- Score global -->
      <div class="rating-hero reveal">
        <div style="display:flex;align-items:center;gap:2rem;flex-wrap:wrap">
          <span class="rating-big"><%= s.google_rating %></span>
          <div class="rating-right">
            <div class="rating-stars-lg" aria-label="Note <%= s.google_rating %> étoiles">
              <% for(let i=0;i<5;i++) { %><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><% } %>
            </div>
            <p class="rating-count"><%= s.google_count %> avis Google vérifiés</p>
          </div>
        </div>
        <a href="https://g.page/r/ChIJs33ZK07rtRIRP4GOyZK_UiY/review" target="_blank" rel="noopener" class="btn btn-outline-dark">
          Laisser un avis Google →
        </a>
      </div>

      <!-- Grille des avis -->
      <div class="reviews-grid-full">
        <% testis.forEach((testi, i) => { %>
        <article class="review-card-full reveal" style="transition-delay:<%= (i%3)*80 %>ms">

          <div class="review-stars-row" aria-label="Note <%= testi.rating %> étoiles">
            <% for(let j=0;j<(testi.rating||5);j++) { %><svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><% } %>
          </div>

          <blockquote>"<%= testi.content %>"</blockquote>

          <div class="review-card-footer">
            <div style="display:flex;align-items:center;gap:.6rem">
              <div class="review-avatar"><%= testi.author.charAt(0).toUpperCase() %></div>
              <div class="review-author-info">
                <strong><%= testi.author %></strong>
                <% if (testi.date_str) { %><time><%= testi.date_str %></time><% } %>
              </div>
            </div>
            <div class="google-g">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
              Google
            </div>
          </div>

        </article>
        <% }) %>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js?v=2"></script>
</body>
</html>
